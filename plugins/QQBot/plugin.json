  "environment": {
    "level": "apply",
    "check": [
      {
        "id": "snowluma",
        "label": "SnowLuma 瀹瑰櫒鍦ㄨ繍琛?,
        "required": true,
        "run": "docker inspect -f '{{.State.Status}}' snowluma 2>/dev/null || echo absent",
        "expect": "^running$",
        "hint": "SnowLuma 瀹瑰櫒鏈繍琛屾垨涓嶅瓨鍦?鈥斺€?鍘汇€孮Q 璐︽埛銆嶇偣銆屽惎鍔ㄣ€嶆垨銆屾壂鐮佺櫥褰曘€嶆媺璧峰畠"
      },
      {
        "id": "onebot",
        "label": "QQ 宸茬櫥褰曪紙OneBot get_login_info锛?,
        "required": true,
        "run": "curl -s -m 5 -X POST http://127.0.0.1:3000/get_login_info -H 'Authorization: Bearer rcsnow' -H 'Content-Type: application/json' -d '{}' | grep -q '\"user_id\"' || { echo 'QQ 鏈櫥褰曟垨 OneBot 鏈氨缁?; exit 1; }; echo logged_in",
        "expect": "^logged_in$",
        "hint": "瀹瑰櫒鍦ㄨ窇浣?QQ 娌＄櫥褰?鈥斺€?鎵撳紑銆孮Q 璐︽埛銆嶉噷鐨勮繙绋嬫闈㈡壂鐮侊紙鐧诲綍鎬佸け鏁堟椂閲嶆壂鍗冲彲锛?
      },
      {
        "id": "deps",
        "label": "rcbot Python 渚濊禆",
        "required": true,
        "run": "/opt/rcbot/venv/bin/python -c 'import aiohttp, aiosqlite, PIL'",
        "hint": "rcbot 鐨?venv 缂哄け鎴栫己渚濊禆"
      },
      {
        "id": "runtime",
        "label": "rcbot 杩愯鏃朵笌閮ㄧ讲涓€鑷翠笖鏈嶅姟鍦ㄨ窇",
        "required": true,
        "run": "for f in rcbot.py rcbot/*.py; do t=\"/opt/rcbot/$f\"; [ -f \"$t\" ] || { echo \"缂哄皯 $t\"; exit 1; }; [ -r \"$t\" ] || { echo \"鏃犳硶璇诲彇 $t(闈㈡澘鏉冮檺涓嶈冻, 鏃犳硶姣斿鐗堟湰)\"; exit 2; }; cmp -s \"$f\" \"$t\" || { echo \"$f 涓庡凡閮ㄧ讲鐗堟湰涓嶄竴鑷碶"; exit 1; }; done; systemctl is-active --quiet rcbot || { echo \"rcbot 鏈嶅姟鏈繍琛孿"; exit 1; }; echo same",
        "hint": "鏈哄櫒浜烘湰浣撴湭閮ㄧ讲銆佺増鏈惤鍚庯紝鎴栨湇鍔℃病鍦ㄨ窇"
      },
      {
        "id": "port6710",
        "label": "rcbot HTTP 绔彛",
        "type": "port",
        "port": 6710,
        "bind": "127.0.0.1",
        "owner": {
          "unit": "rcbot.service"
        },
        "required": true
      },
      {
        "id": "mediadir",
        "label": "濯掍綋鐩綍鍙啓",
        "required": true,
        "run": "d=/opt/rcbot/media; mkdir -p \"$d\" 2>/dev/null || { echo '寤轰笉浜嗗獟浣撶洰褰?; exit 1; }; [ -w \"$d\" ] || { echo '濯掍綋鐩綍涓嶅彲鍐?; exit 1; }; echo writable",
        "hint": "rcbot 瀛樿亰澶╄褰曞獟浣撳壇鏈殑鐩綍锛岀鐩樻弧鎴栨潈闄愪笉瀵逛細璁颁笉涓嬪獟浣?
      },
      {
        "id": "silk",
        "label": "璇煶杞爜鍣紙鍙€夛紝缂轰簡璇煶鍙兘涓嬭浇涓嶈兘鎾斁锛?,
        "required": false,
        "run": "[ -x /opt/rcbot/bin/silk_v3_decoder ] || { echo '娌℃湁 silk_v3_decoder锛岃闊虫棤娉曡浆鐮?; exit 1; }; echo ok",
        "hint": "鍦ㄣ€岀幆澧冨噯澶囥€嶉噷鎵ц銆岀紪璇?silk_v3_decoder銆嶅嵆鍙ˉ涓?
      }
    ],
    "apply": [
      {
        "id": "deps",
        "label": "鍒涘缓 venv 骞跺畨瑁?rcbot 渚濊禆",
        "check": "deps",
        "needs": "root",
        "timeout": 900,
        "run": "set -e\nexport DEBIAN_FRONTEND=noninteractive\nif [ ! -x /opt/rcbot/venv/bin/python ]; then\n  python3 -m venv /opt/rcbot/venv 2>/dev/null || { apt-get update -qq && apt-get install -y -qq python3-venv; python3 -m venv /opt/rcbot/venv; }\nfi\n/opt/rcbot/venv/bin/pip install -q --upgrade pip\n/opt/rcbot/venv/bin/pip install -q 'aiohttp>=3.11' 'aiosqlite>=0.17' 'pillow>=9'"
      },
      {
        "id": "runtime",
        "label": "閮ㄧ讲 rcbot 杩愯鏃跺苟娉ㄥ唽 systemd 鏈嶅姟",
        "check": "runtime",
        "needs": "root",
        "timeout": 180,
        "run": "set -e\ninstall -d -m 0755 /opt/rcbot /opt/rcbot/data /opt/rcbot/logs /opt/rcbot/rcbot\nrm -f /opt/rcbot/rcbot/*.py\ncp -rf rcbot/. /opt/rcbot/rcbot/\ninstall -m 0644 rcbot.py /opt/rcbot/rcbot.py\n# 婧愮爜瑕佸彲璇? 闈?root 鐨勯潰鏉夸篃瑕佽兘姣斿鐗堟湰, 鍚﹀垯妫€鏌ュ彧浼氳\"璇讳笉鍒癨"\nchmod 0644 /opt/rcbot/rcbot/*.py\ncat > /etc/systemd/system/rcbot.service <<'RCBOT_UNIT'\n[Unit]\nDescription=RainCough Bot (rcbot)\nAfter=network.target\n\n[Service]\nType=simple\nWorkingDirectory=/opt/rcbot\nExecStart=/opt/rcbot/venv/bin/python /opt/rcbot/rcbot.py\nRestart=always\nRestartSec=5\nEnvironment=PYTHONUNBUFFERED=1\nEnvironment=RCBOT_LOG_LEVEL=INFO\n\n[Install]\nWantedBy=multi-user.target\nRCBOT_UNIT\nsystemctl daemon-reload\nsystemctl enable rcbot\nsystemctl restart rcbot"
      },
      {
        "id": "silk",
        "label": "缂栬瘧 silk_v3_decoder锛圦Q 璇煶 SILK 鈫?mp3锛屾祻瑙堝櫒鎵嶈兘鎾斁锛?,
        "check": "silk",
        "needs": "root",
        "timeout": 900,
        "run": "set -e\n# QQ 璇煶鏄?SILK锛屾祻瑙堝櫒鏀句笉浜嗭紱ffmpeg 娌℃湁 silk 瑙ｇ爜鍣紙瀹炴祴 5.1.9锛夛紝apt 涔熸病鏈夈€俓n# 杩欓噷缂栬瘧涓€浠?silk_v3_decoder锛宺cbot 鐢ㄥ畠鎶婅闊宠浆鎴?mp3銆俓nmkdir -p /opt/rcbot/bin\nif [ -x /opt/rcbot/bin/silk_v3_decoder ]; then echo already; exit 0; fi\ncommand -v git >/dev/null 2>&1 || { apt-get update -qq && apt-get install -y -qq git build-essential cmake; }\ncommand -v cmake >/dev/null 2>&1 || { apt-get update -qq && apt-get install -y -qq build-essential cmake; }\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit clone --depth 1 https://github.com/foyoux/pilk.git 2>/dev/null || {\n  git clone --depth 1 https://github.com/xiangyuecn/Silk.git . 2>/dev/null || {\n    echo '鎷変笉鍒?silk_v3_decoder 婧愮爜'; exit 1; }\n}\nif [ -d silk ]; then cd silk; fi\nif [ -f CMakeLists.txt ]; then\n  cmake -B build -DCMAKE_BUILD_TYPE=Release >/dev/null\n  cmake --build build -j2 >/dev/null\n  find . -name 'silk_v3_decoder' -type f -perm -u+x | head -1 | xargs -r -I{} cp {} /opt/rcbot/bin/silk_v3_decoder\nelif [ -f Makefile ]; then\n  make -s >/dev/null\n  cp silk_v3_decoder /opt/rcbot/bin/silk_v3_decoder 2>/dev/null || true\nfi\nchmod +x /opt/rcbot/bin/silk_v3_decoder\n[ -x /opt/rcbot/bin/silk_v3_decoder ] || { echo '缂栬瘧娌″嚭鍙墽琛屾枃浠?; exit 1; }\necho ok"
      }
    ]
  }
}

