{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fongwuyan/RainCough-Core/plugins/aidraw/docs/batch.schema.json",
  "title": "AI 绘图批量任务",
  "description": "AI 绘图插件 JSON 批量导入格式",
  "oneOf": [
    {
      "type": "object",
      "required": ["items"],
      "properties": {
        "defaults": { "$ref": "#/$defs/params" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  ],
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "negative_prompt": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "steps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "scale": { "type": "number", "minimum": 1, "maximum": 30 },
        "seed": { "type": "integer" },
        "n": { "type": "integer", "minimum": 1, "maximum": 8 },
        "model": { "type": "string" },
        "strength": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
        "image": { "type": "string" }
      },
      "additionalProperties": true
    },
    "item": {
      "allOf": [
        { "$ref": "#/$defs/params" },
        {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "prompt": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
