{
  "name": "GithubDownloader",
  "label": "GitHub 下载器",
  "version": "1.1.1",
  "description": "扫描 GitHub 仓库并下载整仓、Git 克隆、Release 资产和仓库内任意文件，支持直连与 gh-proxy 加速。",
  "author": "fongwuyan",
  "icon": "",
  "requirements": [],
  "frontend": {
    "entry": "assets/plugin.js",
    "vue": "3.5",
    "pages": [
      {
        "path": "",
        "title": "GitHub 下载器"
      }
    ]
  },
  "backend": {
    "lang": "python",
    "exec": [
      "python3",
      "server_v4.py"
    ],
    "capabilities": [
      "invoke",
      "heartbeat",
      "log.tail"
    ],
    "rest": [
      {
        "method": "GET",
        "path": "/download/{tid}",
        "iface": "ghdl.file",
        "args": {
          "tid": "{tid}"
        },
        "file": "file"
      }
    ]
  },
  "interfaces": [
    {
      "id": "ghdl.info",
      "visibility": "all",
      "version": "1",
      "description": "插件信息",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      }
    },
    {
      "id": "ghdl.scan",
      "visibility": "all",
      "version": "1",
      "description": "扫描仓库可下载内容（同步兼容接口）",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "proxy": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object"
      }
    },
    {
      "id": "ghdl.scan.start",
      "visibility": "all",
      "version": "1",
      "description": "开始异步扫描",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "scan_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "ghdl.scan.status",
      "visibility": "all",
      "version": "1",
      "description": "查询异步扫描",
      "input": {
        "type": "object",
        "properties": {
          "scan_id": {
            "type": "string"
          }
        },
        "required": [
          "scan_id"
        ]
      },
      "output": {
        "type": "object"
      }
    },
    {
      "id": "ghdl.start",
      "visibility": "all",
      "version": "1",
      "description": "创建下载任务",
      "input": {
        "type": "object",
        "properties": {
          "repo_url": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "proxy": {
            "type": "string"
          },
          "items": {
            "type": "array"
          }
        },
        "required": [
          "repo_url",
          "items"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "ghdl.tasks",
      "visibility": "all",
      "version": "1",
      "description": "任务列表/进度",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "ghdl.cancel",
      "visibility": "all",
      "version": "1",
      "description": "取消任务",
      "input": {
        "type": "object",
        "properties": {
          "tid": {
            "type": "string"
          }
        },
        "required": [
          "tid"
        ]
      },
      "output": {
        "type": "object"
      }
    },
    {
      "id": "ghdl.delete",
      "visibility": "all",
      "version": "1",
      "description": "删除任务与文件",
      "input": {
        "type": "object",
        "properties": {
          "tid": {
            "type": "string"
          }
        },
        "required": [
          "tid"
        ]
      },
      "output": {
        "type": "object"
      }
    },
    {
      "id": "ghdl.file",
      "visibility": "all",
      "version": "1",
      "description": "获取任务文件下载地址",
      "input": {
        "type": "object",
        "properties": {
          "tid": {
            "type": "string"
          }
        },
        "required": [
          "tid"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          }
        }
      }
    }
  ]
}
