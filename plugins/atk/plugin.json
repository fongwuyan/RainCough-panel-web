{
  "name": "atk",
  "label": "网络攻防工具库",
  "version": "1.1.0",
  "description": "安全作业编排台: 侦察、检测、验证、解码、取证（纯标准库实现，无第三方依赖；APK 支持到 1GB）",
  "author": "RainCough",
  "icon": "",
  "frontend": {
    "entry": "assets/plugin.js",
    "vue": "3.5",
    "pages": [
      {
        "path": "",
        "title": "网络攻防工具库"
      }
    ]
  },
  "backend": {
    "lang": "python",
    "exec": [
      "python",
      "server_v4.py"
    ],
    "capabilities": [
      "invoke",
      "heartbeat",
      "log.tail"
    ]
  },
  "interfaces": [
    {
      "id": "atk.analyze.chunk",
      "visibility": "main",
      "version": "1",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "description": "分块上传样本（4MB/块，支持到 1GB）"
    },
    {
      "id": "atk.analyze.disasm",
      "visibility": "all",
      "version": "1",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "description": "指定地址反汇编（自研解码器）"
    },
    {
      "id": "atk.analyze.functions",
      "visibility": "all",
      "version": "1",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "description": "函数/符号列表"
