{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raincough.local/plugin.json.v4.schema.json",
  "title": "RainCough 插件清单 v4",
  "type": "object",
  "required": [
    "name",
    "label",
    "version",
    "frontend",
    "backend",
    "interfaces"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "author": {
      "type": "string",
      "maxLength": 128
    },
    "icon": {
      "type": "string",
      "maxLength": 512
    },
    "requirements": {
      "type": "array",
      "description": "旧式 python 依赖声明。★面板只做 import 探测、不会自动安装(历史上这条注释写成\"安装时由面板 pip install\", 与实现不符)。需要自动装请改用 environment.apply",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "environment": {
      "type": "object",
      "description": "环境声明(可选)。缺省 = 无环境要求。level=check(默认) 只跑 check[] 不做任何改动; level=apply 允许面板执行 apply[] 步骤, 但每次都要用户看过命令原文并显式确认, 且只传步骤 id —— 命令原文永远来自本清单, 前端碰不到。",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "check",
            "apply"
          ],
          "default": "check"
        },
        "check": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]*$",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "maxLength": 64
              },
              "type": {
                "enum": [
                  "",
                  "port"
                ],
                "default": ""
              },
              "run": {
                "type": "string",
                "maxLength": 4096,
                "description": "shell 命令, cwd=插件目录。必须无副作用。退出码约定: 0=就绪, 1=确定缺失(默认), 2=无法确定(读不到/权限不足, 不算缺失), 3=已就绪但状态可疑。非 0 且非 1/2/3 一律按缺失处理。"
              },
              "expect": {
                "type": "string",
                "maxLength": 256,
                "description": "对 stdout 的正则; 缺省只看退出码。命令退出 0 但输出不匹配 = 缺失"
              },
              "port": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              },
              "bind": {
                "type": "string",
                "default": "127.0.0.1"
              },
              "owner": {
                "type": "object",
                "description": "端口占用者归属: 命中则视为\"自己占的\"(升级场景不误报冲突)",
                "additionalProperties": false,
                "properties": {
                  "unit": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "plugin": {
                    "enum": [
                      "self"
                    ]
                  }
                }
              },
              "required": {
                "type": "boolean",
                "default": true
              },
              "hint": {
                "type": "string",
                "maxLength": 512
              },
              "guide": {
                "type": "string",
                "maxLength": 512
              },
              "timeout": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1800,
                "default": 30
              }
            }
          }
        },
        "apply": {
          "type": "array",
          "description": "可执行步骤。按声明顺序执行(先建 venv 再 pip 这类顺序作者最清楚, 框架不重排)",
          "items": {
            "type": "object",
            "required": [
              "id",
              "run"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]*$",
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "maxLength": 64
              },
              "run": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "description": "shell 命令, cwd=插件目录"
              },
              "needs": {
                "enum": [
                  "auto",
                  "root"
                ],
                "default": "auto",
                "description": "auto=任何权限都能跑; root=需要 root。面板以非 root 运行时, needs=root 的步骤会被直接拒绝(不 sudo、不降级), 并在报告里标成 denied。"
              },
              "timeout": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600,
                "default": 120
              },
              "check": {
                "type": "string",
                "maxLength": 64,
                "description": "关联的检查项 id: 该检查已就绪就跳过本步(幂等), 点第二次修复不会重复装一遍。"
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": [
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "vue": {
          "type": "string",
          "default": "3.5"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "path": {
                "type": "string",
                "default": ""
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": [
        "exec"
      ],
      "additionalProperties": false,
      "properties": {
        "lang": {
          "type": "string",
          "default": "python"
        },
        "exec": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "invoke",
              "heartbeat",
              "log.tail",
              "stream"
            ]
          }
        },
        "rest": {
          "type": "array",
          "description": "声明式 REST 桥: 把插件接口暴露成普通 HTTP 路由, 给没有 JSON-RPC 能力的客户端(移动端 App)用",
          "items": {
            "type": "object",
            "required": [
              "method",
              "path"
            ],
            "properties": {
              "method": {
                "type": "string",
                "maxLength": 16
              },
              "path": {
                "type": "string",
                "maxLength": 256
              },
              "iface": {
                "type": "string",
                "maxLength": 128
              },
              "args": {
                "type": "object"
              },
              "file": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        "rest_public": {
          "type": "boolean",
          "description": "★已废弃(2026-11-01): 该字段从未被任何代码调用过, 一直是个死开关。现在 /<插件名>/api/... 前缀通道一律要求访问密钥(X-RC-Key 或 ?key=), 与这个字段无关。保留只为不破坏老清单解析"
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$"
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "visibility": {
            "enum": [
              "all",
              "main",
              "private"
            ],
            "default": "all"
          },
          "version": {
            "type": "string",
            "default": "1"
          },
          "description": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    }
  }
}
